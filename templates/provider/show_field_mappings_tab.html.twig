<form method="post" action="{{ form_action }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}"/>
    <input type="hidden" name="plugin_singlesignon_providers_id" value="{{ provider_id }}"/>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">{{ __('Field mappings', 'singlesignon') }}</h3>
        </div>
        <div class="card-body">
            <p class="text-muted">
                {{ __('Configure JSONPath rules used to extract fields from Resource Owner response.', 'singlesignon') }}
            </p>
            <table class="table table-hover align-middle"
                   id="sso-field-mappings-table"
                   data-restore-label="{{ __('Restore') }}">
                <thead>
                    <tr>
                        <th>{{ __('Type') }}</th>
                        <th>{{ __('JSONPath', 'singlesignon') }}</th>
                        <th class="text-center">{{ __('Active') }}</th>
                        <th class="text-center">{{ __('Order') }}</th>
                        <th class="text-center">{{ __('Actions') }}</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
            <div class="mt-3">
                <span class="d-flex gap-2">
                    <button type="button" id="sso-add-mapping-row" class="btn btn-outline-secondary">
                        <i class="ti ti-plus"></i> <span>{{ __('Add') }}</span>
                    </button>
                    <button type="button" id="sso-reset-mappings-btn" class="btn btn-ghost-danger" data-bs-toggle="modal" data-bs-target="#reset_mappings_modal">
                        <span>{{ __('Reset to defaults') }}</span>
                    </button>
                </span>
            </div>
        </div>
        <div class="card-footer text-end">
            <button type="submit" name="update_mappings" class="btn btn-primary">
                <i class="ti ti-device-floppy"></i>
                <span>{{ _x('button', 'Save') }}</span>
            </button>
        </div>
    </div>
</form>

{% include 'components/danger_modal.html.twig' with {
   'modal_id': 'reset_mappings_modal',
   'title': __('Are you sure?'),
   'content': __('Are you sure you want to reset field mappings to the defaults?', 'singlesignon'),
   'confirm_btn': '<button type="button" id="confirm_reset_mappings_btn" class="btn btn-danger w-100" data-bs-dismiss="modal">' ~ _x('button', 'Confirm') ~ '</button>'
} %}

<script type="text/javascript">
(() => {
    const table = document.getElementById('sso-field-mappings-table');
    const addBtn = document.getElementById('sso-add-mapping-row');
    const confirmResetBtn = document.getElementById('confirm_reset_mappings_btn');
    const tbody = table ? table.querySelector('tbody') : null;
    if (!table || !addBtn || !tbody) {
        return;
    }

    const types = {{ field_types|json_encode|raw }};
    const allDefaults = {{ all_defaults|json_encode|raw }};
    const initialMappings = {{ mappings|json_encode|raw }};
    const removeLabel = {{ __('Remove')|json_encode|raw }};
    const readOnlyLabel = {{ __('Read-only fallback', 'singlesignon')|json_encode|raw }};
    const initialType = {{ provider.fields.type|json_encode|raw }};

    let nextRowIndex = 0;

    const buildSelect = (selectedKey = '', name = null, disabled = false) => {
        const select = document.createElement('select');
        select.className = 'form-select';
        if (name) {
            select.name = name;
        }
        select.disabled = disabled;

        Object.entries(types).forEach(([key, label]) => {
            const option = document.createElement('option');
            option.value = key;
            option.textContent = label;
            if (key === selectedKey) {
                option.selected = true;
            }
            select.appendChild(option);
        });

        return select;
    };

    const addCustomRow = (map = null, isSaved = false) => {
        const idx = nextRowIndex++;
        const tr = document.createElement('tr');
        tr.setAttribute('data-row', '');
        tr.setAttribute('data-saved', isSaved ? '1' : '0');

        const mapId = map ? (map.id || 0) : 0;
        const fieldType = map ? (map.field_type || 'id') : 'id';
        const jsonPath = map ? (map.jsonpath || '') : '';
        const isActive = map ? (map.is_active == 1) : true;
        const customCount = tbody.querySelectorAll('tr:not([data-readonly="1"])').length;
        const defaultOrder = (customCount + 1) * 10;
        const sortOrder = map && map.sort_order !== undefined && map.sort_order !== null && map.sort_order !== ''
            ? map.sort_order
            : defaultOrder;

        const typeTd = document.createElement('td');
        const idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.name = `_field_mappings[${idx}][id]`;
        idInput.value = String(mapId);
        typeTd.appendChild(idInput);

        if (isSaved) {
            const deleteInput = document.createElement('input');
            deleteInput.type = 'hidden';
            deleteInput.className = 'sso-delete-flag';
            deleteInput.name = `_field_mappings[${idx}][_delete]`;
            deleteInput.value = '0';
            typeTd.appendChild(deleteInput);
        }

        typeTd.appendChild(buildSelect(fieldType, `_field_mappings[${idx}][field_type]`, false));
        tr.appendChild(typeTd);

        const pathTd = document.createElement('td');
        const pathInput = document.createElement('input');
        pathInput.type = 'text';
        pathInput.className = 'form-control';
        pathInput.name = `_field_mappings[${idx}][jsonpath]`;
        pathInput.value = jsonPath;
        pathInput.placeholder = '$.id';
        pathTd.appendChild(pathInput);
        tr.appendChild(pathTd);

        const activeTd = document.createElement('td');
        activeTd.className = 'text-center';
        const activeInput = document.createElement('input');
        activeInput.type = 'checkbox';
        activeInput.className = 'form-check-input';
        activeInput.name = `_field_mappings[${idx}][is_active]`;
        activeInput.value = '1';
        activeInput.checked = isActive;
        activeTd.appendChild(activeInput);
        tr.appendChild(activeTd);

        const orderTd = document.createElement('td');
        orderTd.className = 'text-center';
        const orderInput = document.createElement('input');
        orderInput.type = 'number';
        orderInput.className = 'form-control text-end';
        orderInput.style.maxWidth = '100px';
        orderInput.style.margin = '0 auto';
        orderInput.name = `_field_mappings[${idx}][sort_order]`;
        orderInput.value = String(sortOrder);
        orderTd.appendChild(orderInput);
        tr.appendChild(orderTd);

        const actionTd = document.createElement('td');
        actionTd.className = 'text-center';
        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn btn-outline-danger btn-sm';
        removeBtn.setAttribute('data-remove-row', '');
        const trashIcon = document.createElement('i');
        trashIcon.className = 'ti ti-trash';
        removeBtn.appendChild(trashIcon);
        removeBtn.appendChild(document.createTextNode(' ' + removeLabel));
        actionTd.appendChild(removeBtn);
        tr.appendChild(actionTd);

        const firstReadonly = tbody.querySelector('tr[data-readonly="1"]');
        if (firstReadonly) {
            tbody.insertBefore(tr, firstReadonly);
        } else {
            tbody.appendChild(tr);
        }
        return tr;
    };

    const loadDefaults = (type) => {
        // Remove existing read-only rows
        tbody.querySelectorAll('tr[data-readonly="1"]').forEach(tr => tr.remove());

        const defaults = allDefaults[type] || [];
        defaults.forEach(map => {
            const tr = document.createElement('tr');
            tr.setAttribute('data-readonly', '1');
            tr.classList.add('bg-light', 'text-muted');

            const typeTd = document.createElement('td');
            typeTd.appendChild(buildSelect(map.field_type || 'id', null, true));
            tr.appendChild(typeTd);

            const pathTd = document.createElement('td');
            const pathInput = document.createElement('input');
            pathInput.type = 'text';
            pathInput.className = 'form-control';
            pathInput.value = map.jsonpath || '';
            pathInput.disabled = true;
            pathTd.appendChild(pathInput);
            tr.appendChild(pathTd);

            const activeTd = document.createElement('td');
            activeTd.className = 'text-center';
            const activeInput = document.createElement('input');
            activeInput.type = 'checkbox';
            activeInput.className = 'form-check-input';
            activeInput.value = '1';
            activeInput.disabled = true;
            activeInput.checked = Boolean(map.is_active);
            activeInput.style.backgroundColor = 'var(--tblr-secondary)';
            activeInput.style.borderColor = 'var(--tblr-secondary)';
            activeTd.appendChild(activeInput);
            tr.appendChild(activeTd);

            const orderTd = document.createElement('td');
            orderTd.className = 'text-center';
            const orderInput = document.createElement('input');
            orderInput.type = 'number';
            orderInput.className = 'form-control text-end';
            orderInput.style.maxWidth = '100px';
            orderInput.style.margin = '0 auto';
            orderInput.value = String(map.sort_order ?? 10);
            orderInput.disabled = true;
            orderTd.appendChild(orderInput);
            tr.appendChild(orderTd);

            const actionTd = document.createElement('td');
            actionTd.className = 'text-center';
            const badge = document.createElement('span');
            badge.className = 'badge';
            badge.style.backgroundColor = 'var(--glpi-badge-bg)';
            badge.title = readOnlyLabel;
            const lockIcon = document.createElement('i');
            lockIcon.className = 'ti ti-lock';
            badge.appendChild(lockIcon);
            actionTd.appendChild(badge);
            tr.appendChild(actionTd);

            tbody.appendChild(tr);
        });
    };

    const init = () => {
        tbody.replaceChildren();
        nextRowIndex = 0;
        if (initialMappings && initialMappings.length > 0) {
            initialMappings.forEach(map => {
                addCustomRow(map, true);
            });
        }
        loadDefaults(initialType);
    };

    addBtn.addEventListener('click', () => {
        addCustomRow(null, false);
    });

    if (confirmResetBtn) {
        confirmResetBtn.addEventListener('click', () => {
            // Remove all custom overrides
            const customRows = tbody.querySelectorAll('tr:not([data-readonly="1"])');
            customRows.forEach(tr => {
                if (tr.getAttribute('data-saved') === '1') {
                    const deleteFlag = tr.querySelector('.sso-delete-flag');
                    if (deleteFlag) deleteFlag.value = '1';
                    tr.style.display = 'none';
                } else {
                    tr.remove();
                }
            });
        });
    }

    $(document).on('change', 'select[name="type"]', function() {
        const newType = $(this).val();
        loadDefaults(newType);
    });

    // Run init
    init();

})();
</script>

<script type="text/javascript" src="{{ get_plugin_web_dir('singlesignon') }}/public/js/mapping-row-actions.js"></script>
